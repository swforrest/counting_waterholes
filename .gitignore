# Re-exported S2 chips (UTM 53S grid, with n_obs band) and everything derived
# from them. cookie-cutting/labels is deliberately NOT ignored: hand-painted
# label masks are small and are the most expensive thing in the pipeline.
cookie-cutting/images_tif_v2
cookie-cutting/derived
cookie-cutting/predictions

# Machine-generated labels: regenerable from pseudo_labelling.ipynb, and there
# are hundreds of them. cookie-cutting/labels (hand-painted) is tracked.
cookie-cutting/labels_pseudo

# The '*Temp*' rule above matches case-insensitively on macOS, which silently
# swallows wh_temporal.py and its tests. Keep them.
!cookie-cutting/wh_temporal.py
!cookie-cutting/tests/test_wh_temporal.py

.pytest_cache

# The dashboard's full built dataset: ~220 MB of overlays regenerated by
# dashboard_webapp/tools/build_dashboard_data.py, shipped to the live site as a
# GitHub Release asset rather than through git. dashboard_webapp/data_sample is
# deliberately NOT ignored — it is the few-site subset that keeps a fresh clone
# and a fallback deploy working, the same bargain as cookie-cutting/labels.
dashboard_webapp/data/
dashboard_webapp/dist/

# Claude Code per-machine local settings
.claude/settings.local.json
